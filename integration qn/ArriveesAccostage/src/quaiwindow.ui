QMainWindow, QDialog {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #ADD8E6);
}
QScrollArea#scroll { background: transparent; }
QWidget#page { background: transparent; }

QMenu {
  background: #101c2c;
  border: 1px solid #23374e;
  border-radius: 10px;
  padding: 6px;
}
QMenu::item {
  padding: 8px 14px;
  color: #e6eef6;
  border-radius: 8px;
}
QMenu::item:selected {
  background: #18304a;
}
QMenu::item:checked {
  color: #39c0fa;
  background: rgba(57,192,250,22);
}

QFrame#sidebar {
  background: #101c2c;
  border-top-right-radius: 16px;
  border-bottom-right-radius: 16px;
}
QLabel#logo {
  background: #ffffff; color: #132437;
  border: 2px solid #ffffff; border-radius: 48px; padding: 0px;
}
QLabel#brandTitle {
  color: #e6eef6; font-size: 16px; font-weight: 800;
}

QPushButton#sideBtn0, QPushButton#sideBtn1, QPushButton#sideBtn2,
QPushButton#sideBtn3, QPushButton#sideBtn4, QPushButton#sideBtn5 {
  text-align: left; padding-left: 12px; color: #e6eef6;
  background: transparent; border: 1px solid transparent;
  border-radius: 10px; font-size: 16px; font-weight: 600;
}
QPushButton#sideBtn0:hover, QPushButton#sideBtn1:hover, QPushButton#sideBtn2:hover,
QPushButton#sideBtn3:hover, QPushButton#sideBtn4:hover, QPushButton#sideBtn5:hover {
  background: #18304a; border-color: #23374e;
}
QPushButton#sideBtn0:checked, QPushButton#sideBtn1:checked, QPushButton#sideBtn2:checked,
QPushButton#sideBtn3:checked, QPushButton#sideBtn4:checked, QPushButton#sideBtn5:checked {
  color: #39c0fa; background: rgba(57,192,250,22); border-color: rgba(57,192,250,90);
}
QPushButton#sideBtn0:pressed, QPushButton#sideBtn1:pressed, QPushButton#sideBtn2:pressed,
QPushButton#sideBtn3:pressed, QPushButton#sideBtn4:pressed, QPushButton#sideBtn5:pressed {
  background: #1a3552;
}

QLabel#headerH1 {
  color: #132437;
  font-size: 28px;
  font-weight: bold;
  font-family: 'Segoe UI', Arial;
  letter-spacing: 0px;
  margin: 0px;
  padding: 0px;
}

QLabel#sectionTitle, QLabel#tableTitle, QLabel#advTitle, QLabel#searchTitle, QLabel#sortTitle,
QLabel#exportTitle, QLabel#statsTitle, QLabel#revTitle, QLabel#occTitle,
QLabel#histTitle, QLabel#rotTitle, QLabel#revHistTitle {
  color: #39c0fa; font-size: 18px; font-weight: 700;
}

QLabel#mapCaption, QLabel#advSub, QLabel#labRef, QLabel#labShip,
QLabel#labShipType, QLabel#proposeResult, QLabel#mapHint, QLabel#histHint,
QLabel#rotSub, QLabel#revHistHint, QLabel#periodLabel, QLabel#pickLab,
QLabel#rotationOcc, QLabel#rotationLibre {
  color: #9bb0c3;
}

QToolButton#menuButton {
  color: #e6eef6; background: #132437;
  border: 1px solid #23374e; border-radius: 10px; font-size: 18px;
}
QToolButton#menuButton:hover { background: #18304a; }

QFrame#actionsCard, QFrame#tableCard, QFrame#statsCard {
  background: #132437; border: 1px solid #23374e; border-radius: 16px;
}

QFrame#advancedCard {
  background: transparent;
  border: 0px;
}
QFrame#searchCard, QFrame#sortCard, QFrame#exportCard,
QFrame#revCard, QFrame#occCard, QFrame#histCard,
QFrame#rotCard, QFrame#revHistCard {
  background: #132437; border: 1px solid #23374e; border-radius: 12px;
}

QFrame#mapBox {
  background: #101c2c; border: 1px solid #23374e; border-radius: 12px;
}

QLineEdit#searchQuai, QLineEdit#searchDate, QLineEdit#traceQuai,
QComboBox#searchEtat, QComboBox#sortMode, QComboBox#exportType,
QComboBox#revenuePeriod, QComboBox#shipType,
QDateTimeEdit#availAt, QDateTimeEdit#rangeStart, QDateTimeEdit#rangeEnd,
QDoubleSpinBox#minPrice, QDoubleSpinBox#maxPrice,
QDoubleSpinBox#refX, QDoubleSpinBox#refY, QDoubleSpinBox#shipLength {
