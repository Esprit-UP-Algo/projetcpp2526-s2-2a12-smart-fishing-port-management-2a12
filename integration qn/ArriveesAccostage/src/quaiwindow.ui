}

QCheckBox { color: #9bb0c3; spacing: 10px; font-size: 14px; }
QCheckBox::indicator {
  width: 16px; height: 16px; border-radius: 4px;
  background: #101c2c; border: 1px solid #23374e;
}
QCheckBox::indicator:checked {
  background: #1e8de0; border: 1px solid #1e8de0;
}
QComboBox::drop-down { border: 0px; width: 20px; }

QPushButton#btnCreate, QPushButton#btnProposeFit, QPushButton#btnPdf {
  background: #1e8de0; color: white; border: 0px;
  border-radius: 10px; padding: 9px 14px; font-weight: 700;
}
QPushButton#btnCreate:hover, QPushButton#btnProposeFit:hover, QPushButton#btnPdf:hover {
  background: #2a99ec;
}

QPushButton#btnUpdate, QPushButton#btnProposeCheapest, QPushButton#btnProposeNearest {
  background: #23374e; color: #e6eef6; border: 1px solid #2b4561;
  border-radius: 10px; padding: 9px 14px;
}
QPushButton#btnUpdate:hover, QPushButton#btnProposeCheapest:hover, QPushButton#btnProposeNearest:hover {
  background: #2b4561;
}

QPushButton#btnDelete {
  background: #39c0fa; color: #0c1a29; border: 0px;
  border-radius: 10px; padding: 9px 14px; font-weight: 700;
}
QPushButton#btnDelete:hover { background: #56cdfc; }

QTableView#table, QTableWidget#table,
QTableView#revByQuaiTable, QTableWidget#revByQuaiTable,
QTableView#occByQuaiTable, QTableWidget#occByQuaiTable,
QTableView#occHistoryTable, QTableWidget#occHistoryTable,
QTableView#revHistoryTable, QTableWidget#revHistoryTable {
