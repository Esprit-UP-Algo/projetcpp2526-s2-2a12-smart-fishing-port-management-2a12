}
QTableView::item:selected { background: #1e8de0; color: #ffffff; }
QTableView::item:selected:!active { background: #1769a8; color: #ffffff; }
QTableView::item:focus { outline: none; border: 0px; }
QTableView:focus { outline: none; }
QHeaderView::section {
  background: #101c2c; color: #9bb0c3; border: 0px;
  padding: 10px 12px; font-weight: 700; font-size: 15px;
}
QTableCornerButton::section { background: #101c2c; border: 0px; }
QTableView::item { padding: 10px 12px; border-radius: 6px; }

QLabel#HeaderH1 {
  color: #132437;
  font-size: 28px;
  font-weight: bold;
  font-family: 'Segoe UI', Arial;
  letter-spacing: 0px;
