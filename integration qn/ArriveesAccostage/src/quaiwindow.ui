}

QPushButton#AltPrimaryButton {
  background: transparent;
  color: #1e8de0;
  border: 2px solid #1e8de0;
  border-radius: 10px;
  padding: 9px 14px;
  font-weight: 700;
  font-size: 14px;
}
QPushButton#AltPrimaryButton:hover {
