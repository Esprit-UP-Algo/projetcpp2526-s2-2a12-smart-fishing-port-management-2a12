  min-height: 44px; font-size: 15px; padding: 8px 14px;
  color: #e6eef6; selection-background-color: #1e8de0;
}
QLineEdit#searchQuai:disabled, QLineEdit#searchDate:disabled, QLineEdit#traceQuai:disabled,
QComboBox#searchEtat:disabled, QComboBox#sortMode:disabled, QComboBox#exportType:disabled,
QComboBox#revenuePeriod:disabled, QComboBox#shipType:disabled,
QDateTimeEdit#availAt:disabled, QDateTimeEdit#rangeStart:disabled, QDateTimeEdit#rangeEnd:disabled,
QDoubleSpinBox#minPrice:disabled, QDoubleSpinBox#maxPrice:disabled,
QDoubleSpinBox#refX:disabled, QDoubleSpinBox#refY:disabled, QDoubleSpinBox#shipLength:disabled {
