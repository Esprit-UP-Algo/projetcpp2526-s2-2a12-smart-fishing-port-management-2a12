  color: white;
  border: 0px;
  border-radius: 10px;
  padding: 9px 14px;
  font-size: 13px;
  font-weight: 700;
}
#btnExportPDF:hover, #btnRechercherUser:hover, #btnPayslipPDF:hover { background-color: #2a99ec; }
QLineEdit {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 11px;
  selection-background-color: #1e8de0;
}
QDateTimeEdit {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  padding-right: 28px;
  min-height: 22px;
  font-size: 11px;
}
QDateTimeEdit::drop-down { border: 0px; width: 20px; }
QComboBox {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 11px;
}
QComboBox::drop-down { border: 0px; width: 20px; }
QComboBox QAbstractItemView {
  background-color: #132437;
  color: #e6eef6;
  selection-background-color: #1e8de0;
  border: 1px solid #23374e;
}
QTableWidget {
  background: transparent;
  alternate-background-color: #101c2c;
  color: #e6eef6;
  border: 0px;
  gridline-color: transparent;
  font-size: 13px;
  selection-background-color: #39c0fa;
  selection-color: #0c1a29;
}
QHeaderView::section {
  background-color: #101c2c;
  color: #9bb0c3;
  border: 0px;
  padding: 8px 10px;
  font-weight: 700;
  font-size: 13px;
}
QTableWidget::item {
  padding: 6px 10px;
  border-radius: 6px;
}
QTableWidget::item:selected { background-color: #39c0fa; color: #0c1a29; }
#chartCA_jour, #chartCA_mois, #chartCA_annee, #chartCA_moyen {
  background-color: #101c2c;
  border: 10px solid #2a3f55;
  border-radius: 75px;
  min-width: 150px; min-height: 150px;
  max-width: 150px; max-height: 150px;
}
#chartQTE, #chartREV {
  background-color: #101c2c;
  border: 10px solid #39c0fa;
  border-radius: 75px;
  min-width: 150px; min-height: 150px;
  max-width: 150px; max-height: 150px;
}
#lblChartTitle_jour, #lblChartTitle_mois, #lblChartTitle_annee, #lblChartTitle_moyen,
#lblChartTitleQTE, #lblChartTitleREV {
  color: #39c0fa;
  font-size: 11px;
  font-weight: 600;
  background: transparent;
  border: none;
}
#lblChartValue_jour, #lblChartValue_mois, #lblChartValue_annee, #lblChartValue_moyen,
#lblChartQTE, #lblChartREV {
  color: #e6eef6;
  font-size: 20px;
  font-weight: bold;
  background: transparent;
  border: none;
}
#lblChartUnit_jour, #lblChartUnit_mois, #lblChartUnit_annee, #lblChartUnit_moyen,
#lblChartUnitQTE, #lblChartUnitREV {
  color: #6a7f93;
  font-size: 10px;
  background: transparent;
  border: none;
}
#lblPeriode {
  color: #9bb0c3;
  font-size: 13px;
}
#comboPeriode {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 13px;
  font-weight: 700;
}
#lblTrierPar, #lblOrdre {
