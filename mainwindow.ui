   <property name="styleSheet">
    <string notr="true">
#centralWidget {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #ADD8E6);
}
QScrollArea#mainScrollArea,
QScrollArea#mainScrollArea QWidget#qt_scrollarea_viewport {
  background: transparent;
}
#scrollContents {
  background: transparent;
}
#sidebar {
  background-color: #101c2c;
  border-top-right-radius: 16px;
  border-bottom-right-radius: 16px;
}
#logoLabel {
  background: white;
  color: #101c2c;
  border: 0px;
  border-radius: 48px;
}
#lblVisionSight {
  color: #d9e3ee;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 1px;
}
#sidebar QPushButton {
  background: transparent;
  color: #c8d3df;
  border: none;
  border-left: 3px solid transparent;
  border-radius: 0px;
  text-align: left;
  padding: 12px 18px;
  font-size: 15px;
  font-weight: 600;
  margin: 2px 12px;
}
#sidebar QPushButton:hover {
  background-color: rgba(57,192,250,0.08);
  color: #e6eef6;
}
#sidebar QPushButton[active="true"] {
  background-color: rgba(57,192,250,0.12);
  color: #39c0fa;
  border-left: 3px solid #39c0fa;
  font-weight: 700;
}
#headerFrame {
  background: transparent;
}
#lblTitle {
  color: #132437;
  font-size: 28px;
  font-weight: bold;
}
#btnMenu {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 800;
}
#btnMenu:hover {
  background-color: #112b41;
}
QFrame#transactionsFrame, QFrame#rechercheFrame, QFrame#triFrame,
QFrame#affichageFrame, QFrame#statsFrame, QFrame#optionsFrame {
  background-color: #132437;
  border: 1px solid #23374e;
  border-radius: 16px;
}
#lblTransactions, #lblRecherche, #lblTri, #lblAffichage,
#lblStatistiquesVentes, #lblOptionsAvancees {
  color: #39c0fa;
  font-size: 18px;
  font-weight: 700;
}
#lblDetection, #lblPrevision {
  color: #9bb0c3;
  font-size: 13px;
}
#btnCreer {
  background-color: #39c0fa;
  color: #0c1a29;
  border: 0px;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 800;
}
#btnCreer:hover { background-color: #56cdfc; }
#btnModifier {
  background-color: #23374e;
  color: #e6eef6;
  border: 1px solid #2b4561;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 800;
}
#btnModifier:hover { background-color: #2b4561; }
#btnSupprimer {
  background-color: #39c0fa;
  color: #0c1a29;
  border: 0px;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 700;
}
#btnSupprimer:hover { background-color: #56cdfc; }
#btnExportPDF {
  background-color: #1e8de0;
  color: white;
  border: 0px;
  border-radius: 10px;
  padding: 9px 14px;
  font-size: 13px;
  font-weight: 700;
}
#btnExportPDF:hover { background-color: #2a99ec; }
QLineEdit {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 11px;
  selection-background-color: #1e8de0;
}
QDateTimeEdit {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  padding-right: 28px;
  min-height: 22px;
  font-size: 11px;
}
QDateTimeEdit::drop-down { border: 0px; width: 20px; }
QComboBox {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 11px;
}
QComboBox::drop-down { border: 0px; width: 20px; }
QComboBox QAbstractItemView {
  background-color: #132437;
  color: #e6eef6;
  selection-background-color: #1e8de0;
  border: 1px solid #23374e;
}
QTableWidget {
  background: transparent;
  alternate-background-color: #101c2c;
  color: #e6eef6;
  border: 0px;
  gridline-color: transparent;
  font-size: 13px;
  selection-background-color: #39c0fa;
  selection-color: #0c1a29;
}
QHeaderView::section {
  background-color: #101c2c;
  color: #9bb0c3;
  border: 0px;
  padding: 8px 10px;
  font-weight: 700;
  font-size: 13px;
}
QTableWidget::item {
  padding: 6px 10px;
  border-radius: 6px;
}
QTableWidget::item:selected { background-color: #39c0fa; color: #0c1a29; }
#chartCA_jour, #chartCA_mois, #chartCA_annee, #chartCA_moyen {
  background-color: #101c2c;
  border: 10px solid #2a3f55;
  border-radius: 75px;
  min-width: 150px; min-height: 150px;
  max-width: 150px; max-height: 150px;
}
#chartQTE, #chartREV {
  background-color: #101c2c;
  border: 10px solid #39c0fa;
  border-radius: 75px;
  min-width: 150px; min-height: 150px;
  max-width: 150px; max-height: 150px;
}
#lblChartTitle_jour, #lblChartTitle_mois, #lblChartTitle_annee, #lblChartTitle_moyen,
#lblChartTitleQTE, #lblChartTitleREV {
  color: #39c0fa;
  font-size: 11px;
  font-weight: 600;
  background: transparent;
  border: none;
}
#lblChartValue_jour, #lblChartValue_mois, #lblChartValue_annee, #lblChartValue_moyen,
#lblChartQTE, #lblChartREV {
  color: #e6eef6;
  font-size: 20px;
  font-weight: bold;
  background: transparent;
  border: none;
}
#lblChartUnit_jour, #lblChartUnit_mois, #lblChartUnit_annee, #lblChartUnit_moyen,
#lblChartUnitQTE, #lblChartUnitREV {
  color: #6a7f93;
  font-size: 10px;
  background: transparent;
  border: none;
}
#lblPeriode {
  color: #9bb0c3;
  font-size: 13px;
}
#comboPeriode {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 4px 10px;
  min-height: 22px;
  font-size: 13px;
  font-weight: 700;
}
#lblTrierPar, #lblOrdre {
  color: #9bb0c3;
  font-size: 13px;
}
QScrollArea {
  background: transparent;
  border: none;
}
QScrollBar:vertical {
  background: #101c2c;
  width: 8px;
  border-radius: 4px;
}
QScrollBar::handle:vertical {
  background: #23374e;
  border-radius: 4px;
  min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
#separator1, #separator2 {
  background-color: #23374e;
  border: none;
  max-height: 1px;
  min-height: 1px;
}
