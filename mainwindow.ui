    <string notr="true">
#centralWidget {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #ADD8E6);
}
QScrollArea#mainScrollArea,
QScrollArea#mainScrollArea QWidget#qt_scrollarea_viewport {
  background: transparent;
}
#scrollContents {
  background: transparent;
}
#sidebar {
  background-color: #101c2c;
  border-top-right-radius: 16px;
  border-bottom-right-radius: 16px;
}
#logoLabel {
  background: white;
  color: #101c2c;
  border: 0px;
  border-radius: 48px;
}
#lblVisionSight {
  color: #d9e3ee;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 1px;
}
#sidebar QPushButton {
  background: transparent;
  color: #c8d3df;
  border: none;
  border-left: 3px solid transparent;
  border-radius: 0px;
  text-align: left;
  padding: 12px 18px;
  font-size: 15px;
  font-weight: 600;
  margin: 2px 12px;
}
#sidebar QPushButton:hover {
  background-color: rgba(57,192,250,0.08);
  color: #e6eef6;
}
#sidebar QPushButton[active="true"] {
  background-color: rgba(57,192,250,0.12);
  color: #39c0fa;
  border-left: 3px solid #39c0fa;
  font-weight: 700;
}
#headerFrame {
  background: transparent;
}
#lblTitle {
  color: #132437;
  font-size: 28px;
  font-weight: bold;
}
#btnMenu {
  background-color: #101c2c;
  color: #e6eef6;
  border: 1px solid #23374e;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 800;
}
#btnMenu:hover {
  background-color: #112b41;
}
QFrame#transactionsFrame, QFrame#rechercheFrame, QFrame#triFrame,
QFrame#affichageFrame, QFrame#statsFrame, QFrame#optionsFrame,
QFrame#empCrudFrame, QFrame#empSearchFrame, QFrame#empSortFrame,
QFrame#empTableFrame, QFrame#empPayslipFrame, QFrame#empStatsFrame, QFrame#empSessionFrame {
  background-color: #132437;
  border: 1px solid #23374e;
  border-radius: 16px;
}
#lblTransactions, #lblRecherche, #lblTri, #lblAffichage,
#lblStatistiquesVentes, #lblOptionsAvancees,
#lblEmpCrud, #lblEmpRecherche, #lblEmpTri, #lblEmpList,
#lblEmpPayslip, #lblEmpStats, #lblEmpSession {
  color: #39c0fa;
  font-size: 18px;
  font-weight: 700;
}
#lblDetection, #lblPrevision {
  color: #9bb0c3;
  font-size: 13px;
}
#btnCreer, #btnCreerUser, #btnPayslipEmail {
  background-color: #39c0fa;
  color: #0c1a29;
  border: 0px;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 800;
}
#btnCreer:hover, #btnCreerUser:hover, #btnPayslipEmail:hover { background-color: #56cdfc; }
#btnModifier, #btnModifierUser, #btnActiverDesactiver, #btnPayslipExcel, #btnTerminerSession {
  background-color: #23374e;
  color: #e6eef6;
  border: 1px solid #2b4561;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 800;
}
#btnModifier:hover, #btnModifierUser:hover, #btnActiverDesactiver:hover,
#btnPayslipExcel:hover, #btnTerminerSession:hover { background-color: #2b4561; }
#btnSupprimer, #btnSupprimerUser {
  background-color: #39c0fa;
  color: #0c1a29;
  border: 0px;
  border-radius: 10px;
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 700;
}
#btnSupprimer:hover, #btnSupprimerUser:hover { background-color: #56cdfc; }
#btnExportPDF, #btnRechercherUser, #btnPayslipPDF {
