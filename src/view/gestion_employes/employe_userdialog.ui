  <property name="styleSheet"><string notr="true">
QDialog#EmployeUserDialog {
  background-color: #101c2c;
  color: #e6eef6;
}
QLabel {
  color: #9bb0c3;
  font-size: 13px;
  font-weight: 700;
  background: transparent;
}
QLineEdit, QComboBox, QDoubleSpinBox, QDateEdit {
  background-color: #132437;
  border: 1px solid #23374e;
  border-radius: 8px;
  padding: 8px 12px;
  color: #e6eef6;
  font-size: 13px;
  min-height: 30px;
  selection-background-color: #1e8de0;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QDateEdit:focus {
  border-color: #39c0fa;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  background: #23374e;
  border: none;
  width: 20px;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
  background: #39c0fa;
}
QComboBox::drop-down {
  border: 0px;
  width: 24px;
}
QComboBox QAbstractItemView {
  background-color: #132437;
  color: #e6eef6;
  selection-background-color: #1e8de0;
  border: 1px solid #23374e;
}
QDateEdit::drop-down {
  border: 0px;
  width: 24px;
}
