QDialog#TransactionDialog {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 #eaf4fb, stop:0.5 #dceef8, stop:1 #cbdfef);
}
QLabel {
  color: #1a2a3a;
  font-size: 13px;
  font-weight: 700;
  background: transparent;
}
QLabel#dialogTitle {
  color: #0f1f2e;
  font-size: 22px;
  font-weight: 800;
}
QLabel#dialogSubtitle {
  color: #5a7a94;
  font-size: 12px;
  font-weight: 400;
}
QLabel#totalValue {
  color: #1a8de0;
  font-size: 16px;
  font-weight: bold;
  background-color: #1a2a3a;
  border: 1px solid #2a3f55;
  border-radius: 8px;
  padding: 6px 12px;
}
QLineEdit {
  background-color: #1a2a3a;
  color: #e6eef6;
  border: 1px solid #2a3f55;
  border-radius: 8px;
  padding: 8px 12px;
  min-height: 30px;
  font-size: 13px;
  font-weight: 400;
  selection-background-color: #1e8de0;
}
QLineEdit:focus {
  border-color: #39a8d8;
}
QDoubleSpinBox {
  background-color: #1a2a3a;
  color: #e6eef6;
  border: 1px solid #2a3f55;
  border-radius: 8px;
  padding: 8px 12px;
  min-height: 30px;
  font-size: 13px;
  font-weight: 400;
}
QDoubleSpinBox:focus {
  border-color: #39a8d8;
}
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  background: #2a3f55;
  border: none;
  width: 20px;
}
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
  background: #39a8d8;
}
QDateTimeEdit {
  background-color: #1a2a3a;
  color: #e6eef6;
  border: 1px solid #2a3f55;
  border-radius: 8px;
  padding: 8px 12px;
  min-height: 30px;
  font-size: 13px;
  font-weight: 400;
}
QDateTimeEdit:focus {
  border-color: #39a8d8;
}
QDateTimeEdit::drop-down {
  border: 0px;
  width: 24px;
}
QComboBox {
  background-color: #1a2a3a;
  color: #e6eef6;
  border: 1px solid #2a3f55;
  border-radius: 8px;
  padding: 8px 12px;
  min-height: 30px;
  font-size: 13px;
  font-weight: 400;
}
QComboBox:focus {
  border-color: #39a8d8;
}
QComboBox::drop-down {
  border: 0px;
  width: 24px;
}
QComboBox QAbstractItemView {
  background-color: #1a2a3a;
  color: #e6eef6;
  selection-background-color: #1e8de0;
  border: 1px solid #2a3f55;
}
#btnOk {
  background-color: #2da4d8;
  color: white;
  border: 0px;
  border-radius: 10px;
  padding: 11px 32px;
  font-size: 14px;
  font-weight: 700;
  min-width: 120px;
}
#btnOk:hover {
  background-color: #3dbae8;
}
#btnCancel {
  background-color: #2da4d8;
  color: white;
  border: 0px;
  border-radius: 10px;
  padding: 11px 32px;
  font-size: 14px;
  font-weight: 700;
  min-width: 120px;
}
#btnCancel:hover {
  background-color: #3dbae8;
}
