/* ===== GLOBAL ===== */
QMainWindow {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #ADD8E6
    );
}

/* ===== SCROLL AREA ===== */
QScrollArea#scrollArea {
    background: transparent;
    border: none;
}
QScrollArea#scrollArea &gt; QWidget &gt; QWidget {
    background: transparent;
}
QWidget#scrollContent {
    background: transparent;
}

/* ===== SIDEBAR ===== */
#sidebar {
    background: #0d1620;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

#lblLogo {
    background: #ffffff;
    color: #e6eef6;
    border: none;
    border-radius: 52px;
    font-weight: 800;
    padding: 18px;
}

#lblSidebarTitle {
    color: #e6eef6;
    font-size: 16px;
    font-weight: 800;
    font-family: 'Segoe UI', Arial;
    letter-spacing: 1px;
}

#sidebar QPushButton {
    text-align: left;
    padding-left: 14px;
    color: #90a4ae;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
    padding: 10px 14px;
    margin: 2px 8px;
}

#sidebar QPushButton:hover {
    color: #cfd8dc;
    background: rgba(38, 198, 218, 0.08);
}

#sidebar QPushButton:checked {
    background: transparent;
    color: #3fc1f9;
    border: none;
    border-left: 3px solid #3fc1f9;
    font-weight: 600;
}

/* ===== HEADER ===== */
#lblAppTitle {
    color: #132437;
    font-size: 28px;
    font-weight: bold;
    font-family: 'Segoe UI', Arial;
}

#lblAppSubtitle {
    color: #132437;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}

#btnMenu {
    color: #e6eef6;
    background: #132437;
    border: 1px solid #23374e;
    border-radius: 10px;
    font-size: 18px;
    font-weight: bold;
}

#btnMenu:hover {
    background: #18304a;
}

/* ===== CARDS ===== */
QFrame#buttonsCard, QFrame#searchCard, QFrame#statsCard,
QFrame#maintenanceCard, QFrame#revenusCard,
QFrame#triCard, QFrame#exportCard, QFrame#gestionCard,
QFrame#weatherCard, QFrame#calendarCard {
    background: #132437;
    border: 1px solid #23374e;
    border-radius: 16px;
}

/* When buttonsCard is inside gestionCard, remove the extra "card" look */
QFrame#gestionCard QFrame#buttonsCard {
    background: transparent;
    border: none;
    border-radius: 0px;
}

QCalendarWidget {
    background: #101c2c;
    color: #e6eef6;
    border: 1px solid #23374e;
    border-radius: 8px;
}
QCalendarWidget QToolButton {
    color: #e6eef6;
    background: #1a2d44;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 700;
}
QCalendarWidget QToolButton:hover {
    background: #23374e;
}
QCalendarWidget QMenu {
    background: #101c2c;
    color: #e6eef6;
}
QCalendarWidget QAbstractItemView {
    background: #101c2c;
    color: #e6eef6;
    selection-background-color: #1e8de0;
    selection-color: #ffffff;
}
QCalendarWidget QAbstractItemView:enabled {
    color: #e6eef6;
}
QCalendarWidget #qt_calendar_navigationbar {
    background: #1a2d44;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

#btnFetchWeather, #btnAddMouvement {
    background: #1e8de0;
    color: white;
    border: 0px;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}
#btnFetchWeather:hover, #btnAddMouvement:hover {
    background: #2a99ec;
}

/* ===== SECTION TITLES ===== */
#lblSearchTitle, #lblStatsTitle, #lblMaintenanceTitle,
#lblRevenusTitle, #lblTriTitle, #lblExportTitle, #lblGestionTitle,
#lblWeatherTitle, #lblCalendarTitle {
    color: #39c0fa;
    font-size: 18px;
    font-weight: 700;
    font-family: 'Segoe UI', Arial;
}

/* ===== CARD SUBTITLES ===== */
#lblMaintenanceSubtitle, #lblRevenusSubtitle, #lblGestionSubtitle,
#lblWeatherSubtitle, #lblCalendarSubtitle {
    color: #7b8fa3;
    font-size: 11px;
    font-weight: 400;
    font-family: 'Segoe UI', Arial;
    padding-bottom: 2px;
}

/* ===== MUTED LABELS ===== */
QLabel[objectName=&quot;Muted&quot;] {
    color: #9bb0c3;
    font-size: 12px;
    font-family: 'Segoe UI', Arial;
}

/* ===== FORM LABELS ===== */
QLabel#lblMuted {
    color: #9bb0c3;
}

/* ===== INPUTS ===== */
QLineEdit, QComboBox, QDateTimeEdit, QDoubleSpinBox, QSpinBox {
    background: #101c2c;
    border: 1px solid #23374e;
    border-radius: 8px;
    min-height: 28px;
    font-size: 13px;
    padding: 4px 10px;
    color: #e6eef6;
    font-family: 'Segoe UI', Arial;
    selection-background-color: #1e8de0;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #1e8de0;
}

QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 24px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9bb0c3;
    width: 0; height: 0;
}

QComboBox QAbstractItemView {
    background: #101c2c;
    border: 1px solid #23374e;
    color: #e6eef6;
    selection-background-color: #1e8de0;
}

QSpinBox::up-button, QSpinBox::down-button {
    background: #23374e;
    border: none;
    width: 20px;
}

QSpinBox::up-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: 5px solid #9bb0c3;
    width: 0; height: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #9bb0c3;
    width: 0; height: 0;
}

/* ===== BUTTONS ===== */
#btnAjouter {
    background: #3fc1f9;
    color: #0b1622;
    border: 0px solid transparent;
    border-radius: 10px;
    padding: 8px 28px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}

#btnAjouter:hover {
    background: #5ed0fc;
}

#btnModifier {
    background: #3a4a5c;
    color: #ffffff;
    border: 0px solid transparent;
    border-radius: 10px;
    padding: 8px 28px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}

#btnModifier:hover {
    background: #455a6f;
}

#btnSupprimer {
    background: #3fc1f9;
    color: #0b1622;
    border: 0px solid transparent;
    border-radius: 10px;
    padding: 8px 28px;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}

#btnSupprimer:hover {
    background: #5ed0fc;
}

#btnExportPDF {
    background: #1e8de0;
    color: white;
    border: 0px;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 14px;
    font-family: 'Segoe UI', Arial;
}

#btnExportPDF:hover {
    background: #2a99ec;
}

/* ===== STAT CIRCLES ===== */
#statCircle1, #statCircle2, #statCircle3 {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#statCircleTitle1, #statCircleTitle2, #statCircleTitle3 {
    color: #39c0fa;
    font-size: 11px;
    font-family: 'Segoe UI', Arial;
}

#statCircleValue1, #statCircleValue2, #statCircleValue3 {
    color: #e6eef6;
    font-size: 20px;
    font-weight: 800;
    font-family: 'Segoe UI', Arial;
}

#statCircleSub1, #statCircleSub2, #statCircleSub3 {
    color: #9bb0c3;
    font-size: 10px;
    font-family: 'Segoe UI', Arial;
}

/* ===== PERIOD LABEL ===== */
#lblPeriod {
    background: #101c2c;
    border: 1px solid #23374e;
    border-radius: 8px;
    color: #e6eef6;
    padding: 4px 10px;
    font-size: 12px;
}

/* ===== TABLES ===== */
QTableWidget {
    background: transparent;
    color: #e6eef6;
    border: 0px;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
    selection-background-color: #2196F3;
    selection-color: #ffffff;
    gridline-color: transparent;
    outline: 0;
}

QTableWidget::item {
    border-bottom: 1px solid #1a2d44;
}

QTableWidget::item:selected {
    background-color: #2196F3;
    color: #ffffff;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: #101c2c;
    color: #9bb0c3;
    border: none;
    border-bottom: 2px solid #23374e;
    font-weight: 700;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
}

/* ===== CHECKBOX ===== */
QCheckBox {
    color: #e6eef6;
    font-size: 13px;
    font-family: 'Segoe UI', Arial;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #23374e;
    border-radius: 4px;
    background: #101c2c;
}

QCheckBox::indicator:checked {
    background: #1e8de0;
    border-color: #1e8de0;
}

/* ===== ACCENT TEXT ===== */
#lblAccent {
    color: #39c0fa;
    font-size: 12px;
    font-family: 'Segoe UI', Arial;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #23374e;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #2b4561;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #23374e;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
